{
  "manifest_version": 3,
  "name": "My React Extension",
  "version": "1.0",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://uni.tsu.ge/schedule"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["scripting"]
}
